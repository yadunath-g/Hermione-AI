def hex_to_ansi(hex_code):
    h = hex_code.lstrip('#')
    r, g, b = int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)
    return f"\033[38;2;{r};{g};{b}m"

def ansi256(n):
    return f"\033[38;5;{n}m"

