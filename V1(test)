def load_memory():
    default_structure = {"profile": {"name": "Yadu"}, "people": {}, "projects": {}, "preferences": {}, "history": []}
    if os.path.exists(MEMORY_FILE):
        try:
            with open(MEMORY_FILE, 'r', encoding='utf-8') as f:
                data = json.load(f)
                if isinstance(data, dict):
                    for k in ["profile", "people", "projects", "preferences"]:
                        if k not in data:
                            data[k] = default_structure[k]
                    history = [m for m in data.get("history", []) if m.get("role") != "system"]
                    return data, history
        except Exception:
            pass
    return default_structure, []

def save_memory(full_memory, history):
    full_memory["history"] = [m for m in history if m.get("role") != "system"]
    if os.path.exists(MEMORY_FILE):
        try:
            with open(MEMORY_FILE, 'r', encoding='utf-8') as f:
                existing_data = json.load(f)
                if isinstance(existing_data, dict):
                    existing_data.update(full_memory)
                    full_memory = existing_data
        except Exception:
            pass

    with open(MEMORY_FILE, 'w', encoding='utf-8') as f:
        json.dump(full_memory, f, indent=4)

