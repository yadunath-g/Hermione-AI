def execute_system_task(action_payload):
    normalized = action_payload.replace("\\n", "\n")
    log_lines = []
    def log(line): log_lines.append(line)

    macro_matches = re.finditer(r'\b([A-Z_0-9]+)\((.*?)\)', normalized, re.DOTALL)
    commands_found = list(macro_matches)

    if not commands_found:
        return f"{C_DIM}No valid workspace automation execution signature matched.{R}"

    for match in commands_found:
        func_name = match.group(1).upper()
        raw_args_str = match.group(2).strip()

        if "YT" in func_name or "YOUTUBE" in func_name:
            func_name = "PLAY_YT"
        elif "SEARCH" in func_name or "FIND" in func_name or "GOOGLE" in func_name:
            func_name = "WEB_SEARCH"
        elif "DIR" in func_name or "FOLDER" in func_name:
            func_name = "CREATE_DIR"
        elif "DOC" in func_name or "TYPE" in func_name:
            func_name = "AUTOMATE_DOCS"
        elif "FILE" in func_name or "WRITE" in func_name:
            func_name = "WRITE_FILE"
        elif "APP" in func_name or "OPEN" in func_name or "LAUNCH" in func_name:
            func_name = "OPEN_APP"
        elif "HOT" in func_name or "KEY" in func_name or "SHORTCUT" in func_name:
            func_name = "HOTKEY"
        elif "SHOT" in func_name or "CAPTURE" in func_name or "SCREEN" in func_name:
            func_name = "SCREENSHOT"

        args = [arg.strip(" '\"") for arg in re.findall(r'\'[^\']*\'|"[^"]*"|[^,]+', raw_args_str) if arg.strip()]

        try:
            if func_name == "PLAY_YT" and args:
                query = args[0]
                webbrowser.open(f"https://www.youtube.com/results?search_query={query.replace(' ', '+')}")
                log(f"{C_GREEN}●{R} {C_CYAN}Media Stream Dispatched{R} {C_DIM}→{R} {C_YELLOW}{B}\"{query}\"{R}")

            elif func_name == "WEB_SEARCH" and args:
                query = args[0]
                webbrowser.open(f"https://duckduckgo.com/?q={query.replace(' ', '+')}")
                log(f"{C_GREEN}●{R} {C_CYAN}Web Search Dispatched{R} {C_DIM}→{R} {C_YELLOW}{B}\"{query}\"{R}")

            elif func_name == "CREATE_DIR" and args:
                safe = re.sub(r'[^\w\-_/.]', '', args[0])
                os.makedirs(safe, exist_ok=True)
                log(f"{C_GREEN}●{R} {C_LIME}Directory Ready{R} {C_DIM}→{R} {C_WHITE}./{safe}{R}")

            elif func_name == "WRITE_FILE" and len(args) >= 2:
                fname = re.sub(r'[^\w\-_./]', '', args[0])
                content = args[1]
                with open(fname, "w", encoding="utf-8") as f:
                    f.write(content)
                log(f"{C_GREEN}●{R} {C_BLUE}File Written{R} {C_DIM}→{R} {C_WHITE}./{fname}{R} {C_DIM}({len(content)} bytes){R}")

            elif func_name == "OPEN_APP" and args:
                app = args[0].lower().strip()
                app_map = {
                    "vscode": "code", "vs code": "code", "code": "code",
                    "terminal": "gnome-terminal" if platform.system() != "Windows" else "cmd",
                    "files": "nautilus" if platform.system() != "Windows" else "explorer",
                    "firefox": "firefox", "chrome": "google-chrome", "spotify": "spotify"
                }
                cmd = app_map.get(app, app)
                subprocess.Popen(cmd, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                log(f"{C_GREEN}●{R} {C_LIME}Application Fired{R} {C_DIM}→{R} {C_WHITE}{cmd}{R}")

            elif func_name == "HOTKEY" and args:
                combo = args[0].lower().strip()
                keys = [k.strip() for k in combo.split('+')]
                time.sleep(0.3)
                pyautogui.hotkey(*keys)
                log(f"{C_GREEN}●{R} {C_CYAN}Hotkey Executed{R} {C_DIM}→{R} {C_YELLOW}{B}{combo}{R}")

            elif func_name == "SCREENSHOT":
                ts = datetime.datetime.now().strftime('%Y%m%d_%H%M%S')
                path = os.path.expanduser(f"~/Pictures/hermione_{ts}.png")
                os.makedirs(os.path.expanduser("~/Pictures"), exist_ok=True)
                pyautogui.screenshot().save(path)
                log(f"{C_GREEN}●{R} {C_TEAL}Screenshot Saved{R} {C_DIM}→{R} {C_WHITE}{path}{R}")

            elif func_name == "SYS_DIAGNOSTICS":
                cpu_pct  = psutil.cpu_percent()
                mem      = psutil.virtual_memory()
                mem_pct  = mem.percent
                mem_used = mem.used // 1048576
                mem_total = mem.total // 1048576
                try: disk_pct = psutil.disk_usage('/').percent
                except: disk_pct = 0

                cpu_bar  = make_bar(cpu_pct,  24, pct_color(cpu_pct))
                mem_bar  = make_bar(mem_pct,  24, pct_color(mem_pct))
                disk_bar = make_bar(disk_pct, 24, pct_color(disk_pct))

                log(box_top("WORKSTATION CORE RESOURCE DIAGNOSTICS", C_CYAN))
                log(box_mid("OS ENVIRONMENT PROFILE", C_CYAN))
                log(box_row(f"{C_DIM}Kernel Signature {R}{C_TEAL}{B}{platform.system()} {platform.release()}{R}"))
                log(box_mid("HARDWARE METRICS", C_CYAN))
                log(box_row(f"{C_DIM}CPU   {R}{cpu_bar}  {pct_color(cpu_pct)}{B}{cpu_pct:.1f}%{R}"))
                log(box_row(f"{C_DIM}MEM   {R}{mem_bar}  {pct_color(mem_pct)}{B}{mem_pct:.1f}%{R}  {C_DIM}({mem_used}MB / {mem_total}MB){R}"))
                log(box_row(f"{C_DIM}DISK  {R}{disk_bar}  {pct_color(disk_pct)}{B}{disk_pct}%{R}"))
                log(box_bot(C_CYAN))

        except Exception as e:
            log(f"{C_RED}{B}[EXEC_FAIL]{R} {C_AMBER}{func_name}{R} {C_DIM}→ {str(e)}{R}")

    return "\n".join(log_lines) if log_lines else f"{C_DIM}No workspace tasks executed.{R}"

def print_workspace_status(log_text):
    if "╔" in log_text:
        print(f"\n{C_CYAN}{B}Workspace Status Update:{R}")
        print(log_text)
        return
    lines = log_text.strip().split("\n")
    print(f"\n{C_CYAN}{B}Workspace Status Update:{R}")
    print(sub_top("CO-PILOT EXECUTION LOG", C_CYAN))
    for line in lines:
        print(sub_row(line))
    print(sub_bot(C_CYAN))

