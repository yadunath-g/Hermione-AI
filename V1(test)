W = 76

def box_top(title="", color=C_CYAN, w=W):
    if title:
        pad = w - len(title) - 4
        return f"{color}╔══[ {B}{title}{R}{color} ]{'═'*pad}╗{R}"
    return f"{color}╔{'═'*w}╗{R}"

def box_mid(label="", color=C_CYAN, w=W):
    if label:
        pad = w - len(label) - 4
        return f"{color}╠══[ {C_DIM}{label}{color} ]{'─'*pad}╣{R}"
    return f"{color}╠{'═'*w}╣{R}"

def box_row(content, color=C_CYAN, w=W):
    visible = re.sub(r'\033\[[0-9;]*m', '', content)
    pad = max(0, w - len(visible) - 1)
    return f"{color}║{R} {content}{' '*pad}{color}║{R}"

def box_bot(color=C_CYAN, w=W):
    return f"{color}╚{'═'*w}╝{R}"

def sub_top(title="", color=C_DIM, w=W-2):
    if title:
        pad = w - len(title) - 4
        return f"  {color}┌─[ {C_WHITE}{title}{color} ]{'─'*pad}┐{R}"
    return f"  {color}┌{'─'*w}┐{R}"

def sub_row(content, color=C_DIM, w=W-2):
    visible = re.sub(r'\033\[[0-9;]*m', '', content)
    pad = max(0, w - len(visible) - 1)
    return f"  {color}│{R} {content}{' '*pad}{color}│{R}"

def sub_bot(color=C_DIM, w=W-2):
    return f"  {color}└{'─'*w}┘{R}"

def make_bar(pct, length=24, fill_color=C_GREEN, empty_color=C_DIM):
    filled = round(pct / 100 * length)
    return f"{fill_color}{'█'*filled}{C_DIM}{'░'*(length-filled)}{R}"

def pct_color(pct):
    if pct >= 80: return C_RED
    if pct >= 55: return C_AMBER
    return C_GREEN

