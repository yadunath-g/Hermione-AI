def emotion_color(act_lower):
    for keywords, color in EMOTION_MAP.items():
        if any(k in act_lower for k in keywords):
            return color
    return NEUTRAL

def format_reply(text):
    clean = re.sub(r'(?:\\033|\033|\\u001b|\[)?\d+;\d+;\d+(?:\d+)?m?', '', text)
    clean = re.sub(r'\[\d+;\d+;\d+m', '', clean)
    clean = re.sub(r'\b\d+;\d+;\d+m\b', '', clean)
    clean = re.sub(r'```[\s\S]*?```', '', clean).strip()

    # Step 1: Render bold text (**bold**)
    clean = re.sub(r'\*\*(.+?)\*\*', lambda m: f"{B}{m.group(1)}{R}{IVORY}", clean)

    # Step 2: Render action cues (*action*) without interfering with bold formatting
    def color_action(match):
        act = match.group(0).lower()
        c = emotion_color(act)
        return f"{c}{B}{match.group(0)}{R}{IVORY}"

    return f"{IVORY}{re.sub(r'(?<!\*)\*([^*]+?)\*(?!\*)', color_action, clean)}{R}"

def type_out(text, delay=0.01):
    with stdout_lock:
        ansi_pattern = re.compile(r'(\033\[[0-9;]*m)')
        tokens = ansi_pattern.split(text)
        for token in tokens:
            if ansi_pattern.match(token):
                sys.stdout.write(token)
                sys.stdout.flush()
            else:
                for char in token:
                    sys.stdout.write(char)
                    sys.stdout.flush()
                    time.sleep(delay)
        print()

def thinking_indicator(stop_event):
    frames = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]
    i = 0
    while not stop_event.is_set():
        with stdout_lock:
            sys.stdout.write(f"\r  {C_DIM}{frames[i % len(frames)]} Hermione is thinking...{R}   ")
            sys.stdout.flush()
        i += 1
        time.sleep(0.08)
    with stdout_lock:
        sys.stdout.write("\r\033[K")
        sys.stdout.flush()

