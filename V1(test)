def chat_with_hermione():
    global ACTIVE_MODEL
    full_memory, history = load_memory()
    os.system('clear' if os.name == 'posix' else 'cls')
    print_banner()

    # 1. Boot greeting with guaranteed thread termination
    stop_event = threading.Event()
    think_thread = threading.Thread(target=thinking_indicator, args=(stop_event,), daemon=True)
    think_thread.start()

    greet = "*Nods cleanly* Subsystem links bound. Ready, Yadu."
    try:
        current_time_str = datetime.datetime.now().strftime('%I:%M %p')
        instr = get_dynamic_instructions(full_memory)

        completion = client.chat.completions.create(
            model=ACTIVE_MODEL,
            messages=[
                {"role": "system", "content": instr},
                {"role": "user", "content": f"It is {current_time_str}. Short warm companion greeting to Yadu."}
            ],
            temperature=0.2,
            response_format={"type": "json_object"}
        )
        data = json.loads(completion.choices[0].message.content)
        greet = data.get("speech", greet)
        history.append({"role": "assistant", "content": json.dumps(data)})
    except Exception:
        pass
    finally:
        stop_event.set()
        think_thread.join()

    formatted = format_reply(greet)
    sys.stdout.write(f"{AGENT_COLOR}{B}Hermione:{R} ")
    sys.stdout.flush()
    type_out(formatted, delay=0.01)

